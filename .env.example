# Local server
APP_NAME=Visual Pozdr
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
# Set by Electron for a packaged application. Leave empty for browser/dev launch.
FRONTEND_DIST_DIR=
MIN_FREE_DISK_MB=1024

# Use a unique local value in real runs. Do not commit secrets.
LOCAL_SESSION_SECRET=change-me-local-only

# Telegram bot. Keep the real token only in local .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Video preparation
VIDEO_WORKER_CONCURRENCY=1
TELEGRAM_DOWNLOAD_TIMEOUT_SEC=60
FFPROBE_TIMEOUT_SEC=20
FFMPEG_TIMEOUT_SEC=120
FFMPEG_PATH=
FFPROBE_PATH=
VIDEO_PROCESSING_RETRIES=2
VIDEO_PROCESSING_RETRY_DELAY_SEC=3
VIDEO_WORKER_POLL_INTERVAL_SEC=2

# Screen playback
SCREEN_HEARTBEAT_TIMEOUT_SEC=10
SCREEN_LOAD_TIMEOUT_SEC=12
